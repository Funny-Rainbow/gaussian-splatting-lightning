ninja_required_version = 1.3
cxx = c++
nvcc = /home/ubuntu/miniconda3/envs/gspl/bin/nvcc

cflags = -pthread -B /home/ubuntu/miniconda3/envs/gspl/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/ubuntu/miniconda3/envs/gspl/include -fPIC -O2 -isystem /home/ubuntu/miniconda3/envs/gspl/include -fPIC -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include/TH -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include/THC -I/home/ubuntu/miniconda3/envs/gspl/include -I/home/ubuntu/miniconda3/envs/gspl/include/python3.9 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include/TH -I/home/ubuntu/miniconda3/envs/gspl/lib/python3.9/site-packages/torch/include/THC -I/home/ubuntu/miniconda3/envs/gspl/include -I/home/ubuntu/miniconda3/envs/gspl/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_80,code=sm_80 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/ubuntu/3dgs_deps/gaussian-splatting-lightning/vendor/simple-knn/build/temp.linux-x86_64-cpython-39/ext.o: compile /home/ubuntu/3dgs_deps/gaussian-splatting-lightning/vendor/simple-knn/ext.cpp
build /home/ubuntu/3dgs_deps/gaussian-splatting-lightning/vendor/simple-knn/build/temp.linux-x86_64-cpython-39/simple_knn.o: cuda_compile /home/ubuntu/3dgs_deps/gaussian-splatting-lightning/vendor/simple-knn/simple_knn.cu
build /home/ubuntu/3dgs_deps/gaussian-splatting-lightning/vendor/simple-knn/build/temp.linux-x86_64-cpython-39/spatial.o: cuda_compile /home/ubuntu/3dgs_deps/gaussian-splatting-lightning/vendor/simple-knn/spatial.cu






